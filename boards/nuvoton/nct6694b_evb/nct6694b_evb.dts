			"GPIO14_PinH4","GPIO15_PinH3","GPIO16_PinH2","GPIO17_PinJ4";
};

&gpio2 {
	gpio-line-names = "GPIO20_PinM4","GPIO21_PinL4","GPIO22_PinJ5","GPIO23_PinK4",
			"GPIO24_PinK5","GPIO25_PinL5","GPIO26_PinM5","GPIO27_PinG6";
};

&gpio3 {
	gpio-line-names = "GPIO30_PinJ6","GPIO31_PinK6","GPIO32_PinJ7","GPIO33_PinK7",
			"GPIO34_PinL6","GPIO35_PinM6","GPIO36_PinL7","GPIO37_PinM7";
};

&gpio4 {
	gpio-line-names = "GPIO40_PinM8","GPIO41_PinM9","GPIO42_PinM10","GPIO43_PinM11",
			"GPIO44_PinM12","GPIO45_PinL12","GPIO46_PinK12","GPIO47_PinJ12";
};

