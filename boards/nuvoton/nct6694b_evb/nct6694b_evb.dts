&gpio6 {
	gpio-line-names = "GPIO60_PinK10","GPIO61_PinK11","GPIO62_PinJ10","GPIO63_PinJ11_ATXPGD",
			"GPIO64_PinH11","GPIO65_PinG9_SLPS5","GPIO66_PinD12","GPIO67_PinC12";

