		mft = <&tach1>;
		pin-select = <NCT_TACH_PIN_SELECT_5>;
		sample-clk = <NCT_TACH_FREQ_LFCLK>;
		pulses-per-round = <2>;
		pinctrl-0 = <&ta5_sl_gpa4>;
		pinctrl-names = "default";
		status = "okay";
	};
	fan6_tach: fan6-tach {
		compatible = "nuvoton,nct-tach-input";
		mft = <&tach1>;
		pin-select = <NCT_TACH_PIN_SELECT_6>;
		sample-clk = <NCT_TACH_FREQ_LFCLK>;
		pulses-per-round = <2>;
		pinctrl-0 = <&ta6_sl_gpa6>;
		pinctrl-names = "default";
		status = "okay";
	};
	fan7_tach: fan7-tach {
		compatible = "nuvoton,nct-tach-input";
		mft = <&tach1>;
		pin-select = <NCT_TACH_PIN_SELECT_7>;
		sample-clk = <NCT_TACH_FREQ_LFCLK>;
		pulses-per-round = <2>;
		pinctrl-0 = <&ta7_sl_gp01>;
		pinctrl-names = "default";
		status = "okay";
	};
	fan8_tach: fan8-tach {
		compatible = "nuvoton,nct-tach-input";
		mft = <&tach1>;
		pin-select = <NCT_TACH_PIN_SELECT_8>;
		sample-clk = <NCT_TACH_FREQ_LFCLK>;
		pulses-per-round = <2>;
		pinctrl-0 = <&ta8_sl_gp03>;
