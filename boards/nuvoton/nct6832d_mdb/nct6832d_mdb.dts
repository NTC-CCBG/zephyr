		status = "okay";
	};
	fan9_tach: fan9-tach {
		compatible = "nuvoton,nct-tach-input";
		mft = <&tach1>;
		pin-select = <NCT_TACH_PIN_SELECT_9>;
		sample-clk = <NCT_TACH_FREQ_LFCLK>;
		pulses-per-round = <2>;
		pinctrl-0 = <&ta9_sl_gp07>;
		pinctrl-names = "default";
		status = "okay";
	};
	fan10_tach: fan10-tach {
		compatible = "nuvoton,nct-tach-input";
